<UserControl x:Class="AutomationEdariSamyaran.WPF.Views.Workflow.RollUcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutomationEdariSamyaran.WPF.Views.Workflow"
                   xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
               xmlns:vm="clr-namespace:AutomationEdariSamyaran.WPF.ViewModels"
              FontFamily="{StaticResource MyFontName}" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"   BorderBrush="LightGray" BorderThickness="2" FlowDirection="RightToLeft">



    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <Border Grid.Row="0" Grid.ColumnSpan="4" Height="50"   Margin="5">
                <Border Grid.Row="0" Grid.Column="0" CornerRadius="5" BorderThickness="1" BorderBrush="LightGray" >
                    <DockPanel>
                        <TextBox Width="200" Margin="5"   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Command="{Binding SearchCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"   Margin="5"   Background="White" BorderBrush="DarkKhaki"
    Foreground="DarkKhaki" Style="{StaticResource MaterialDesignOutlinedButton}" Width="130" VerticalAlignment="Center" HorizontalAlignment="Left" >
                            <DockPanel>
                                <materialDesign:PackIcon Kind="CarFind" Width="20" Height="20" Foreground="DarkKhaki"/>
                                <TextBlock Text="جستجو" Margin="5,0,0,0"/>
                            </DockPanel>
                        </Button>
                        
                        <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"   Margin="5"   Background="White" BorderBrush="Green"
    Foreground="Green" Style="{StaticResource MaterialDesignOutlinedButton}" Width="130" VerticalAlignment="Center" HorizontalAlignment="Left" >
                            <DockPanel>
                                <materialDesign:PackIcon Kind="AccountBadgeOutline" Width="20" Height="20" Foreground="Green"/>
                                <TextBlock Text="جدید" Margin="5,0,0,0"/>
                            </DockPanel>
                        </Button>

                        <TextBlock      Margin="5"   Background="Transparent"  Foreground="Black"     VerticalAlignment="Center" HorizontalAlignment="Right" >
                            <DockPanel>
                                <TextBlock Text="لیست نقش‌ها" Margin="5,0,0,0"/>
                                <materialDesign:PackIcon Kind="AccountBadgeOutline" Width="20" Height="20" Foreground="Black"/>
                                
                            </DockPanel>
                        </TextBlock>
                        
                    </DockPanel>

                </Border>

              
            </Border>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" AutoGenerateColumns="False"  IsReadOnly="True"
             CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" Margin="0,0,0,0" Grid.Row="1">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="نام کامل" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- ستون ویرایش -->
                    <DataGridTemplateColumn Header="ویرایش" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="ویرایش" 
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"  Style="{StaticResource MaterialDesignOutlinedButton}" Background="White" BorderBrush="Blue"
                       Foreground="Blue"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ستون حذف -->
                    <DataGridTemplateColumn Header="حذف" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف" 
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Background="White" BorderBrush="#D32F2F"
                       Foreground="#D32F2F"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
