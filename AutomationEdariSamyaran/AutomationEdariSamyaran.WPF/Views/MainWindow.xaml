<Window x:Class="AutomationEdariSamyaran.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomationEdariSamyaran.WPF"
        xmlns:view="clr-namespace:AutomationEdariSamyaran.WPF.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:icon="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:vm="clr-namespace:AutomationEdariSamyaran.WPF.ViewModels"
        mc:Ignorable="d"
        Title="اتوماسیون اداری سمیاران"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Language="fa-IR"
        FontFamily="Tahoma"
        materialDesign:ColorZoneAssist.Mode="PrimaryDark">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <DockPanel FlowDirection="RightToLeft">

        <!-- Ribbon شبیه آفیس -->
        <TabControl DockPanel.Dock="Top"
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    Height="100"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    FlowDirection="RightToLeft">

            <!-- تب خانه -->
            <TabItem Header="خانه">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Command="{Binding NewPersonalCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5"  >
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right">
                            <icon:PackIcon Kind="FolderOpenOutline" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="لیست پرسنل"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIcon Kind="FolderOpenOutline" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="باز کردن" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="ذخیره" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>

            <!-- تب ویرایش -->
            <TabItem Header="ویرایش">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button Command="{Binding CutCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIcon Kind="ContentCut" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="برش" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CopyCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIcon Kind="ContentCopy" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="کپی" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PasteCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIcon Kind="ContentPaste" Width="20" Height="20" Margin="5,0,0,0"/>
                            <TextBlock Text="چسباندن" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- محتوای اصلی -->
        <Border Margin="10" CornerRadius="8" md:ElevationAssist.Elevation="Dp4">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>


    </DockPanel>
</Window>
