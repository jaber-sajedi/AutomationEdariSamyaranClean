<Window x:Class="AutomationEdariSamyaran.WPF.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomationEdariSamyaran.WPF.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="جستجو" Height="450" Width="700"
    WindowStartupLocation="CenterScreen"  WindowStyle="None"  Background="#f5f5f5"
        FlowDirection="RightToLeft">

    <materialDesign:Card >

        <StackPanel>
            <Border Height="30" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}" Background="SlateGray" Margin="0" MouseLeftButtonDown=" UIElement_OnMouseLeftButtonDown">
                <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"  Background="Transparent" Foreground="White"   HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="0" Padding="0" BorderThickness="0"
        >
                    <DockPanel >
                        <materialDesign:PackIcon Kind="Close" Width="30" Height="30" Foreground="Red"/>
                    </DockPanel>
                </Button>
            </Border>
            <!-- عنوان -->
            <TextBlock Text="جستجو" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,12"
                   DockPanel.Dock="Top"
                   Foreground="{DynamicResource PrimaryHueMidBrush}"  />

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 🔍 باکس جستجو -->
                <TextBox Grid.Row="0" FlowDirection="RightToLeft"
                     Margin="0,0,0,12"
                     materialDesign:HintAssist.Hint="عبارت جستجو..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden" />

                <!-- 📋 جدول نتایج -->
                <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      Margin="0,0,0,12"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      SelectionMode="Single"      
                      SelectionUnit="FullRow" FlowDirection="RightToLeft"  AutoGeneratingColumn=" DataGrid_OnAutoGeneratingColumn"/>

                <!-- ✅ دکمه‌ها -->
                <DockPanel Grid.Row="2"   HorizontalAlignment="Right"  >

                    <Button Command="{Binding ConfirmCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="4" Grid.Row="8" Margin="5 15" Height="40" Background="White" BorderBrush="Green"
                            Foreground="Green" Style="{StaticResource MaterialDesignOutlinedButton}" Width="130" VerticalAlignment="Bottom">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="Green"/>
                            <TextBlock Text="تایید" Margin="5,0,0,0"/>
                        </DockPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="4" Grid.Row="8" Margin="5 15" Height="40" Background="White" BorderBrush="Red"
          Foreground="Red" Style="{StaticResource MaterialDesignOutlinedButton}" Width="130" VerticalAlignment="Bottom">

                        <DockPanel>
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="Red"/>
                            <TextBlock Text="انصراف" Margin="5,0,0,0"/>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Grid>
        </StackPanel>
    </materialDesign:Card>
</Window>
