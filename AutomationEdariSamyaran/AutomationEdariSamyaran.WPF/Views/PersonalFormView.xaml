<Window x:Class="AutomationEdariSamyaran.WPF.Views.PersonalFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AutomationEdariSamyaran.WPF.ViewModels" 
        xmlns:persianDateControls="clr-namespace:Mohsen.PersianDateControls;assembly=Mohsen.PersianDateControls"
        xmlns:converter="clr-namespace:AutomationEdariSamyaran.WPF.Converter"
        mc:Ignorable="d"
        Title="فرم پرسنل" Height="550" Width="850" FlowDirection="RightToLeft" 
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#f5f5f5" >

    <Window.DataContext>
        <vm:PersonalViewModel />
    </Window.DataContext>
    <Window.Resources>
        <converter:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>
    </Window.Resources>

    <materialDesign:Card Background="WhiteSmoke" BorderThickness="2" BorderBrush="Black" Margin="3">

        <StackPanel  >
            <Border Height="30" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}" Background="SlateGray" Margin="0" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"  Background="Transparent" Foreground="White"   HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="0" Padding="0" BorderThickness="0"
       >
                    <DockPanel >
                        <materialDesign:PackIcon Kind="Close" Width="30" Height="30" Foreground="Red"/>
                    </DockPanel>
                </Button>
            </Border>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- ردیف 0 -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- عکس -->
                    <RowDefinition Height="Auto"/>
                    <!-- دکمه‌ها -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- ردیف 0 -->
                <TextBlock Text="نام کامل:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.FullName}" Grid.Row="0" Grid.Column="1" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="نام کامل"/>
                <TextBlock Text="کد پرسنلی:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.PersonalCode}" Grid.Row="0" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    materialDesign:HintAssist.Hint="کد پرسنلی"/>

                <!-- ردیف 1 -->
                <TextBlock Text="ایمیل:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.Email}" Grid.Row="1" Grid.Column="1" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="ایمیل"/>
                <TextBlock Text="شماره تماس:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.Phone}" Grid.Row="1" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="شماره تماس"/>

                <!-- ردیف 2 -->
                <TextBlock Text="تاریخ تولد:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <persianDateControls:PersianDatePicker Grid.Row="2" Grid.Column="1" Text="{Binding CurrentDate,Mode=TwoWay}" Background="Transparent" FontFamily="B 
Nazanin"/>
                <TextBlock Text="کد ملی:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.NationalCode}" Grid.Row="2" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="کد ملی"/>

                <!-- ردیف 3 -->
                <TextBlock Text="آدرس:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.Address}" Grid.Row="3" Grid.Column="1" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="آدرس"/>
                <TextBlock Text="شهر تولد:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.BirthCity}" Grid.Row="3" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="شهر تولد"/>

                <!-- ردیف 4 -->
                <TextBlock Text="استان تولد:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>

                <DockPanel Grid.Row="4" Grid.Column="1">
                    <TextBox Text="{Binding Personal.BirthProvince}"  Margin="5" Style="{StaticResource MaterialDesignFloatingHintTextBox}"  materialDesign:HintAssist.Hint="استان تولد"/>

                </DockPanel>
                <TextBlock Text="شماره بیمه:" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.InsuranceNumber}" Grid.Row="4" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="شماره بیمه"/>

                <!-- ردیف 5 -->
                <TextBlock Text="تعداد فرزند:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.NumberOfChildren}" Grid.Row="5" Grid.Column="1" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="تعداد فرزند"/>
                <TextBlock Text="تلفن اضطراری:" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.EmergencyContactPhone}" Grid.Row="5" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="تلفن اضطراری"/>

                <!-- ردیف 6 -->
                <TextBlock Text="شماره حساب:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.BankAccountNumber}" Grid.Row="6" Grid.Column="1" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="شماره حساب"/>
                <TextBlock Text="نام بانک:" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Personal.BankName}" Grid.Row="6" Grid.Column="3" Margin="5"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                    materialDesign:HintAssist.Hint="نام بانک"/>

                <TextBlock Text="تاریخ شروع به کار:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0 15"/>
                <persianDateControls:PersianDatePicker Grid.Row="7" Grid.Column="1" Text="{Binding CurrentDate,Mode=TwoWay}" Background="Transparent" FontFamily="B 
Nazanin"/>
                <TextBlock Text="تاریخ ترک کار:" Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" Margin="0 15"/>
                <persianDateControls:PersianDatePicker Grid.Row="7" Grid.Column="3" Text="{Binding CurrentDate,Mode=TwoWay}" Background="Transparent" FontFamily="B 
Nazanin"/>


                <TextBlock Text="وضعیت تاهل:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0 15"/>
                <ComboBox Grid.Row="8"
                          Grid.Column="1"
                          Margin="5"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          materialDesign:HintAssist.Hint="وضعیت تأهل"
                          ItemsSource="{Binding MaritalStatusList}"
                          SelectedItem="{Binding SelectedMaritalStatus, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <!-- ردیف 7: انتخاب عکس -->

                <StackPanel Grid.Row="0" Grid.Column="5" Grid.RowSpan="5" VerticalAlignment="Top" >
                    <TextBlock Text="عکس پرسنل:"  VerticalAlignment="Top"/>
                    <Border   Grid.ColumnSpan="2" Height="120" Width="120" Margin="5" CornerRadius="5" 
    Background="White"  >
                        <Border BorderThickness="2" BorderBrush="LightGray">
                            <Image Source="{Binding  PhotoPath,Mode=TwoWay}" Stretch="UniformToFill" />
                        </Border>
                    </Border>

                    <Button Command="{Binding SelectPhotoCommand}" Margin="5" Background="White" Height="30" BorderBrush="Blue">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="FileSearch" Width="15" Height="15" Foreground="Blue"/>
                            <TextBlock Text="انتخاب فایل" Margin="5,0,0,0"/>
                        </DockPanel>
                    </Button>
                </StackPanel>




                <!-- ردیف 8: دکمه‌ها -->

                <Button Command="{Binding SaveCommand}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="9" Margin="5 15" Height="40" Width="130" Background="#1976D2" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Style="{StaticResource MaterialDesignRaisedButton}">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" Foreground="White"/>
                        <TextBlock Text="ذخیره" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>
                <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="4" Grid.Row="9" Margin="5 15" Height="40" Background="White" BorderBrush="#D32F2F"
                       Foreground="#D32F2F" Style="{StaticResource MaterialDesignOutlinedButton}" Width="130" VerticalAlignment="Bottom">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#D32F2F"/>
                        <TextBlock Text="انصراف" Margin="5,0,0,0"/>
                    </DockPanel>
                </Button>


            </Grid>
        </StackPanel>
    </materialDesign:Card>
</Window>
