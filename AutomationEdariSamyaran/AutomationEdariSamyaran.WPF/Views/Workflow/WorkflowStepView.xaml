<Window x:Class="AutomationEdariSamyaran.WPF.Views.WorkflowStepView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Stepها" Height="400" Width="600" FlowDirection="RightToLeft"
        WindowStyle="None" WindowStartupLocation="CenterScreen"      Background="#f5f5f5">
    <materialDesign:Card  Background="WhiteSmoke" BorderThickness="2" BorderBrush="Black" Margin="3">
       <StackPanel>
           <Border Height="30" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}" Background="SlateGray" Margin="0" MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
               <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"  Background="Transparent" Foreground="White"   HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="0" Padding="0" BorderThickness="0"
               >
                   <DockPanel >
                       <materialDesign:PackIcon Kind="Close" Width="30" Height="30" Foreground="Red"/>
                   </DockPanel>
               </Button>
           </Border>

            <DataGrid ItemsSource="{Binding Steps}" AutoGenerateColumns="False">
               <DataGrid.Columns>
                   <DataGridTextColumn Header="نام Step" Binding="{Binding Name}" />
                   <DataGridTextColumn Header="ترتیب" Binding="{Binding Order}" />
                   <DataGridTextColumn Header="نقش" Binding="{Binding Role.Name}" />
               </DataGrid.Columns>
           </DataGrid>
        </StackPanel>
    </materialDesign:Card>
</Window>
