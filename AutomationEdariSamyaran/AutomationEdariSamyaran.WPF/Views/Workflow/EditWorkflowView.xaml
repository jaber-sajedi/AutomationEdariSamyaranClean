<Window x:Class="AutomationEdariSamyaran.WPF.Views.EditWorkflowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomationEdariSamyaran.WPF.Views"
        mc:Ignorable="d" xmlns:Converter="clr-namespace:AutomationEdariSamyaran.WPF.Converter"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="EditWorkflowView" Height="450" Width="800 "  WindowStartupLocation="CenterScreen"  WindowStyle="None"  Background="#f5f5f5"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Converter:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <materialDesign:Card  Background="WhiteSmoke" BorderThickness="2" BorderBrush="Black" Margin="3">
        <StackPanel>
            <Border Height="30" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}" Background="SlateGray" Margin="0" MouseLeftButtonDown=" UIElement_OnMouseLeftButtonDown">
                <Button Command="{Binding CancelCommand}"   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"  Background="Transparent" Foreground="White"   HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="0" Padding="0" BorderThickness="0"
                >
                    <DockPanel >
                        <materialDesign:PackIcon Kind="Close" Width="30" Height="30" Foreground="Red"/>
                    </DockPanel>
                </Button>
            </Border>
            <!-- Name با Watermark -->
            <Grid>
                <TextBox Text="{Binding Name, Mode=TwoWay}" Name="txtName"/>
                <TextBlock Text="نام Workflow" Foreground="Gray" 
                           Margin="5,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="{Binding Text, ElementName=txtName, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>

            <!-- Description با Watermark -->
            <Grid Margin="0,5,0,10">
                <TextBox Text="{Binding Description, Mode=TwoWay}" Name="txtDescription"/>
                <TextBlock Text="توضیحات" Foreground="Gray" 
                           Margin="5,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="{Binding Text, ElementName=txtDescription, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>

            <Button Content="ذخیره" Command="{Binding SaveCommand}" Width="100" HorizontalAlignment="Right"/>
        </StackPanel>
        </materialDesign:Card>
</Window>
