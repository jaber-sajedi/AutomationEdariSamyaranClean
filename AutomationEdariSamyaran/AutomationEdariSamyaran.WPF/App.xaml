<Application x:Class="AutomationEdariSamyaran.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationEdariSamyaran.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- تم اصلی -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                         PrimaryColor="BlueGrey"
                                         SecondaryColor="Amber" />

                <!-- Defaults نسخه 5 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="MyFontName">/InternetMoneyTransfer;component/ViewModels/Fonts/Vazir-Medium.ttf</FontFamily>
       
            
        </ResourceDictionary>
        
        
    </Application.Resources>

</Application>
